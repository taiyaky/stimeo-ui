<%# Idle / session-timeout demo: the controller watches document-level activity and,
    after a short demo timeout, fires prompt -> idle; interacting again fires active.
    Real apps use a ~15-minute timeout; this demo shortens it (6s, warning at 3s) so the
    transitions are visible. The two notices are declared regions: the controller owns
    hidden on them and shows each only while its own phase holds, so both are authored
    hidden and no consumer JS is needed. Status semantics are this markup's to give. %>
<div
  class="idle-demo"
  data-controller="stimeo--idle"
  data-stimeo--idle-timeout-value="6000"
  data-stimeo--idle-prompt-before-value="3000">
  <p class="idle-demo__hint"><%= t("components.idle.demo.hint") %></p>
  <p
    class="idle-demo__notice idle-demo__notice--prompt"
    role="status"
    data-stimeo--idle-target="prompt"
    hidden><%= t("components.idle.demo.prompt") %></p>
  <p
    class="idle-demo__notice idle-demo__notice--idle"
    role="status"
    data-stimeo--idle-target="idle"
    hidden><%= t("components.idle.demo.idle") %></p>
</div>
