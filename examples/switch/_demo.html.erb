<%# Markup for the switch (APG Switch) demo.
    The controller element itself is a role="switch" button, with state expressed only via
    aria-checked. Space/Enter and click toggle it. The look switches on aria-checked in
    the Playground's CSS. %>
<button
  type="button"
  class="switch"
  role="switch"
  aria-checked="false"
  data-controller="stimeo--switch"
  data-action="click->stimeo--switch#toggle keydown->stimeo--switch#onKeydown">
  <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
  <span class="switch__label"><%= t("components.switch.demo.label") %></span>
  <%# The hidden field carries the on/off state into the form; it is optional.
      A hidden input is not interactive content, so it is valid inside the button. %>
  <input type="hidden" name="notify" data-stimeo--switch-target="field" />
</button>

<%# Readout: what the component just reported. Purely visual — the component
    already announces what a screen reader needs, so this line is aria-hidden to
    keep it from being read twice. The value is a code fragment (API identifiers
    and values), so only the label is translated. %>
<p class="demo-readout" aria-hidden="true">
  <span><%= t("catalog.readout.field") %></span>
  <span class="demo-readout__value" data-readout
        data-empty-text="<%= t("catalog.readout.empty") %>">—</span>
</p>
